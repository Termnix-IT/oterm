# API キー専用のファイル。config.toml と同じディレクトリに
# secrets.toml という名前で置く (このファイルの拡張子 .example を外す)。
#
#   Windows: %APPDATA%\oterm\config\secrets.toml
#   macOS:   ~/Library/Application Support/oterm/secrets.toml
#   Linux:   ~/.config/oterm/secrets.toml
#
# config.toml と分けているのは、設定本体を共有したり dotfile として
# 管理したりしてもキーが混ざらないようにするため。
#
# キーの探索順は secrets.toml → ANTHROPIC_API_KEY 環境変数 →
# config.toml の [ai].api_key (旧方式)。
# ローカルの Ollama を使う場合はキー不要。

anthropic_api_key = "sk-ant-..."
